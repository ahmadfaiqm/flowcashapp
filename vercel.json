{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "be": {
      "root": "be",
      "framework": "express",
      "buildCommand": "npx prisma generate"
    },
    "fe": {
      "root": "fe",
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "be" } },
    { "source": "/(.*)", "destination": { "service": "fe" } }
  ]
}
