NODE_ENV=production
PORT=3000
# Railway Postgres → gunakan value dari ${{Postgres.DATABASE_URL}} (atau copy dari Variables Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projectbln1
JWT_SECRET=isi-min-32-char-random-di-railway-variables
JWT_EXPIRES_IN=1d
LOG_LEVEL=info
# Lokal: http://localhost:5173 — Produksi: https://<nama-fe>.vercel.app (boleh comma-separated)
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Supabase: DIRECT_URL = port 5432 (migrations), DATABASE_URL = port 6543 pooler (runtime)
# e.g. DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1
# e.g. DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/projectbln1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
