// Generated from prisma/schema.prisma 2026-09-16 — sinkron dengan sistem saat ini
// Catatan sistem: pagination 10/page untuk semua list (businesses, journals, sales/purchase/receipt/payment, products, reports, transfer history)
// Penomoran: invoiceNo/receiptNo/paymentNo bisa manual atau auto via prefix client (SI, PB, RC, PP) -> sistem generate {prefix}{001} urut global per business per prefix per tabel (src/common/utils/numbering.js)
// JournalNo auto: JU-SALES-*, JU-PURCHASE-*, JU-RECEIPT-*, JU-PAYMENT-*, JU-MANUAL-*, JU-TRF-*, JU-DEP-*

Enum user_role {
  owner
  kasir
  akuntan
}

Enum account_type {
  Asset
  Liability
  Equity
  Revenue
  Expense
}

Enum journal_status {
  draft
  posted
  void
}

Enum invoice_status {
  draft
  posted
  paid
  partially_paid
  cancelled
}

Enum payment_method {
  cash
  bank_transfer
  e_wallet
  other
}

Table users {
  id int [pk, increment]
  name varchar(100) [not null]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table business_profiles {
  id int [pk, increment]
  owner_user_id int [not null, ref: > users.id]
  business_name varchar(150) [not null]
  address text
  phone varchar(30)
  tax_id varchar(50)
  base_currency varchar(10) [default: 'IDR']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    owner_user_id
  }
}

Table business_members {
  id int [pk, increment]
  business_id int [not null, ref: > business_profiles.id]
  user_id int [not null, ref: > users.id]
  role user_role [not null, default: 'kasir']
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]

  Indexes {
    (business_id, user_id) [unique]
    user_id
  }
}

